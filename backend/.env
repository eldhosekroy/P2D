# AWS
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_COGNITO_USER_POOL_ID=your_cognito_pool_id
AWS_COGNITO_CLIENT_ID=your_cognito_client_id
AWS_S3_BUCKET_NAME=p2d-uploads
AWS_SQS_QUEUE_URL=your_sqs_queue_url

# Supabase (Free PostgreSQL)
SUPABASE_URL=https://yourproject.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_key

# Upstash Redis (Free Cache)
UPSTASH_REDIS_URL=your_upstash_redis_url
UPSTASH_REDIS_TOKEN=your_upstash_redis_token

# Firebase
FIREBASE_SERVER_KEY=your_firebase_server_key
FIREBASE_PROJECT_ID=your_firebase_project_id

# Fast2SMS (Free Indian SMS)
FAST2SMS_API_KEY=your_fast2sms_key

# Razorpay
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret

# Cloudflare
CF_ZONE_ID=your_cloudflare_zone_id
CF_API_TOKEN=your_cloudflare_token

# Sentry
SENTRY_DSN=https://xxxxx@sentry.io/xxxxxx

# Security secrets (generate with: openssl rand -hex 32)
JWT_SECRET=your_64_char_hex_secret
QR_HMAC_SECRET=your_64_char_hex_secret
ENCRYPTION_KEY=your_32_char_encryption_key

# App config
NODE_ENV=development
APP_NAME=P2D
APP_VERSION=1.0.0
